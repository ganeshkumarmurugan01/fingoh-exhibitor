{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/upload.js": {
      "maxDuration": 120
    },
    "api/proxy.js": {
      "maxDuration": 180
    }
  },
  "rewrites": [
    {
      "source": "/api/:slug*",
      "destination": "/api/proxy?slug=:slug*"
    },
    {
      "source": "/meeting",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
